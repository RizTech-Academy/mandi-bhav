<?xml version="1.0" encoding="utf-8"?>
<!--
    What Android copies to a new phone, for Android 12 and later. Only the
    home market is the user's own choice; the prices are a cache that a
    refresh downloads again, so they stay behind.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/user_preferences.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/user_preferences.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
