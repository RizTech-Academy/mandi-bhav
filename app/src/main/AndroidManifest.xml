<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Downloads the prices and the commodity pictures. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Lets the app tell "no connection" from "server down", and sync when the connection returns. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Price alerts. A runtime permission from Android 13; asked when the first alert is saved. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".MandiBhavApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MandiBhav">
        <!-- singleTop: a notification tapped while the app is open is
             delivered to the activity already showing, through onNewIntent,
             instead of starting a second copy of the app on top of it. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WorkManager is configured by MandiBhavApplication, with Hilt's
             worker factory, so its default start-up initialiser is removed. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
