<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Downloads the prices and the commodity pictures. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Lets the app tell "no connection" from "server down", and sync when the connection returns. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Price alerts. A runtime permission from Android 13; asked when the first alert is saved. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The nearest market. Approximate only: a market is chosen by town, not by street.
         A runtime permission; asked when the user taps "Use my location" on the Markets tab.
         No CAMERA and no storage permission: the camera app takes the sale slip photo, and
         the photo picker hands over only the picture the user chose. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:name=".MandiBhavApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MandiBhav">
        <!-- singleTop: a notification tapped while the app is open is
             delivered to the activity already showing, through onNewIntent,
             instead of starting a second copy of the app on top of it. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep links: mandibhav://price?market=…&commodity=… and mandibhav://alerts.
                 BROWSABLE lets a link in a web page or a message open them, so
                 MainActivity checks every link before acting on it. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mandibhav" />
                <data android:host="price" />
                <data android:host="alerts" />
            </intent-filter>
        </activity>

        <!-- Hands the camera app a file to write the sale slip photo into,
             as a content:// Uri it can write to for that one request. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- WorkManager is configured by MandiBhavApplication, with Hilt's
             worker factory, so its default start-up initialiser is removed. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
